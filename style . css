*{box-sizing:border-box;margin:0;padding:0}
body{font-family:Arial,Helvetica,sans-serif;background:#fff;color:#171717}
header{height:72px;background:#b40000;color:#fff;display:flex;align-items:center;justify-content:space-between;padding:0 7%;position:sticky;top:0;z-index:10}
.logo{font-size:25px;font-weight:900;letter-spacing:1px}.logo span{font-weight:400}
nav{display:flex;gap:25px}nav a{color:#fff;text-decoration:none;font-weight:700}
.hero{min-height:520px;padding:90px 7%;display:flex;align-items:center;background:linear-gradient(120deg,#fff 0%,#fff5f5 55%,#e50000 55%,#b40000 100%)}
.hero>div{max-width:600px}.tag{color:#b40000;font-weight:800;letter-spacing:2px;margin-bottom:18px}
h1{font-size:56px;line-height:1.05;margin-bottom:20px}.hero p:not(.tag){font-size:19px;line-height:1.6;margin-bottom:30px}
.btn,.order,.whatsapp{display:inline-block;background:#c40000;color:#fff;text-decoration:none;padding:14px 24px;border-radius:8px;font-weight:800}.btn:hover,.order:hover,.whatsapp:hover{background:#8d0000}
.products{padding:75px 7%;text-align:center}h2{font-size:34px}.subtitle{margin:10px 0 35px;color:#666}
.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:25px}.card{padding:25px;border-radius:15px;background:#fff;box-shadow:0 8px 25px #00000012}.shoe{height:180px;border-radius:12px;background:#f5f5f5;display:flex;align-items:center;justify-content:center;font-size:90px;margin-bottom:20px}.card h3{font-size:21px;margin-bottom:10px}.price{color:#777;margin-bottom:18px}.order{padding:11px 18px}
.contact{padding:70px 7%;text-align:center;background:#170000;color:#fff}.contact p{margin:12px 0 25px;color:#ddd}.whatsapp{background:#c40000}
footer{text-align:center;padding:22px;background:#0b0b0b;color:#aaa}
@media(max-width:750px){header{padding:0 5%}nav{gap:12px;font-size:13px}.hero{min-height:500px;padding:60px 6%;background:linear-gradient(150deg,#fff 0%,#fff 65%,#b40000 65%)}h1{font-size:42px}.grid{grid-template-columns:1fr}.products{padding:55px 6%}}
